{#
/**
 * @file
 * Default theme implementation to display a formatted responsive image field.
 *
 * Available variables:
 * - responsive_image: A collection of responsive image data.
 * - url: An optional URL the image can be linked to.
 * - link_attributes: HTML attributes for the link wrapping the image.
 *
 * @see \Drupal\responsive_image\Hook\ResponsiveImageThemeHooks::preprocessResponsiveImageFormatter()
 *
 * @ingroup themeable
 */
#}
{% if url %}
  {% set link_attributes = link_attributes.setAttribute('href', url) %}

  <a{{ link_attributes }}>
    {{ responsive_image }}
  </a>
{% else %}
  {{ responsive_image }}
{% endif %}
